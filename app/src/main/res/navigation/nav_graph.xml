<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/productDetailFragment">

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.trishop.app.presentation.detail.ProductDetailFragment"
        android:label="@string/detail_title"
        tools:layout="@layout/fragment_product_detail">

        <argument
            android:name="productId"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.trishop.app.presentation.auth.LoginFragment"
        android:label="@string/auth_login_title"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.trishop.app.presentation.auth.RegisterFragment"
        android:label="@string/auth_register_title"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/compareFragment"
        android:name="com.trishop.app.presentation.compare.CompareFragment"
        android:label="@string/compare_title"
        tools:layout="@layout/fragment_compare" />

</navigation>
