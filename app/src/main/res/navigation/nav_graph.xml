<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.trishop.app.presentation.home.HomeFragment"
        android:label="@string/home_title"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/productDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.trishop.app.presentation.catalog.CatalogFragment"
        android:label="@string/catalog_title"
        tools:layout="@layout/fragment_catalog">

        <action
            android:id="@+id/action_catalog_to_detail"
            app:destination="@id/productDetailFragment" />

        <action
            android:id="@+id/action_catalog_to_search"
            app:destination="@id/searchFragment" />

        <action
            android:id="@+id/action_catalog_to_login"
            app:destination="@id/loginFragment" />

        <action
            android:id="@+id/action_catalog_to_profile"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_catalog_to_compare"
            app:destination="@id/compareFragment" />

    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.trishop.app.presentation.detail.ProductDetailFragment"
        android:label="@string/detail_title"
        tools:layout="@layout/fragment_product_detail">

        <argument
            android:name="productId"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.trishop.app.presentation.auth.LoginFragment"
        android:label="@string/auth_login_title"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.trishop.app.presentation.auth.RegisterFragment"
        android:label="@string/auth_register_title"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/compareFragment"
        android:name="com.trishop.app.presentation.compare.CompareFragment"
        android:label="@string/compare_title"
        tools:layout="@layout/fragment_compare" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.trishop.app.presentation.search.SearchFragment"
        android:label="@string/search_title"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/action_search_to_detail"
            app:destination="@id/productDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.trishop.app.presentation.cart.CartFragment"
        android:label="@string/cart_title"
        tools:layout="@layout/fragment_cart">

        <action
            android:id="@+id/action_cart_to_checkout"
            app:destination="@id/checkoutFragment" />

    </fragment>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.trishop.app.presentation.checkout.CheckoutFragment"
        android:label="@string/checkout_title"
        tools:layout="@layout/fragment_checkout">

        <argument
            android:name="couponCode"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="discountPercent"
            app:argType="float"
            android:defaultValue="0.0" />

        <action
            android:id="@+id/action_checkout_to_confirmation"
            app:destination="@id/orderConfirmationFragment"
            app:popUpTo="@id/cartFragment"
            app:popUpToInclusive="false" />

    </fragment>

    <fragment
        android:id="@+id/orderConfirmationFragment"
        android:name="com.trishop.app.presentation.confirmation.OrderConfirmationFragment"
        android:label="@string/confirmation_title"
        tools:layout="@layout/fragment_order_confirmation">

        <argument
            android:name="orderId"
            app:argType="string" />
        <argument
            android:name="total"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/wishlistFragment"
        android:name="com.trishop.app.presentation.wishlist.WishlistFragment"
        android:label="@string/wishlist_title"
        tools:layout="@layout/fragment_wishlist">

        <action
            android:id="@+id/action_wishlist_to_detail"
            app:destination="@id/productDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.trishop.app.presentation.settings.SettingsFragment"
        android:label="@string/profile_menu_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/helpSupportFragment"
        android:name="com.trishop.app.presentation.help.HelpSupportFragment"
        android:label="@string/help_title"
        tools:layout="@layout/fragment_help_support" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.trishop.app.presentation.profile.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profile_to_orders"
            app:destination="@id/orderHistoryFragment" />

        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment" />

        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment" />

        <action
            android:id="@+id/action_profile_to_help"
            app:destination="@id/helpSupportFragment" />

    </fragment>

    <fragment
        android:id="@+id/orderHistoryFragment"
        android:name="com.trishop.app.presentation.profile.orders.OrderHistoryFragment"
        android:label="@string/orders_title"
        tools:layout="@layout/fragment_order_history">

        <action
            android:id="@+id/action_orders_to_order_detail"
            app:destination="@id/orderDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.trishop.app.presentation.profile.orders.OrderDetailFragment"
        android:label="@string/order_detail_title"
        tools:layout="@layout/fragment_order_detail">

        <argument
            android:name="orderId"
            app:argType="string" />

    </fragment>

</navigation>
