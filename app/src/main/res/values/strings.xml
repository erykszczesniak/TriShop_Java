    <string name="help_title">Help &amp; Support</string>
    <string name="help_subtitle">Find answers to the most common questions about TriShop.</string>
    <string name="help_contact">Contact support</string>
    <string name="help_contact_email" translatable="false">support@trishop.com</string>
    <string name="help_faq_q1">What payment methods do you accept?</string>
    <string name="help_faq_a1">We accept Visa, Mastercard, American Express, PayPal, and Apple Pay. All transactions are secured with SSL encryption.</string>
    <string name="help_faq_q2">How long does shipping take?</string>
    <string name="help_faq_a2">Standard shipping takes 5-7 business days. Express shipping is available for 2-3 business days. Free shipping on orders over $100.</string>
    <string name="help_faq_q3">Can I return or exchange an item?</string>
    <string name="help_faq_a3">Yes! We offer a 30-day return policy. Items must be unused and in original packaging.</string>
    <string name="help_faq_q4">Do you ship internationally?</string>
    <string name="help_faq_a4">Currently we ship to the US, Canada, UK, and EU countries. International shipping typically takes 7-14 business days.</string>
    <string name="help_faq_q5">How do I track my order?</string>
    <string name="help_faq_a5">Once your order ships, you\'ll receive a tracking number via email. You can also view order status in your account under Orders.</string>
    <string name="help_faq_q6">What is your warranty policy?</string>
    <string name="help_faq_a6">All products come with a minimum 1-year manufacturer warranty. Bikes and wetsuits include an extended 2-year warranty through TriShop.</string>
    <string name="help_faq_q7">Can I cancel or modify my order?</string>
    <string name="help_faq_a7">Orders can be cancelled or modified within 1 hour of placement. After that, please contact our support team.</string>
    <string name="help_faq_q8">Do you offer price matching?</string>
    <string name="help_faq_a8">Yes, we offer price matching on identical items from authorized retailers. Contact us with the competitor\'s listing.</string>
