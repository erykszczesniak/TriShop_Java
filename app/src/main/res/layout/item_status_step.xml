<?xml version="1.0" encoding="utf-8"?>
<!-- iOS OrderDetail stepper cell: 12dp dot above a small centered label, fill-equal columns. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="@dimen/spacing_xs">

    <View
        android:id="@+id/viewDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/circle_fill" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.TriShop.Mono.Caption2"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
