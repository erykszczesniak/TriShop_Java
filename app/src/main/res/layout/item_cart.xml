<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TriShop.Card.Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_xs">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/cell_padding">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProduct"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@color/neutral_0"
            android:contentDescription="@string/catalog_image_desc"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TriShop.Thumb"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:textAppearance="@style/TextAppearance.TriShop.Card"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/ivProduct"
            app:layout_constraintStart_toEndOf="@id/ivProduct"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvVariant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.TriShop.Mono.Badge"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            app:layout_constraintStart_toEndOf="@id/ivProduct"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/qtyGroup"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_s"
            android:background="@drawable/bg_qty_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/tvVariant"
            app:layout_constraintStart_toEndOf="@id/ivProduct">

            <ImageButton
                android:id="@+id/btnMinus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cart_qty_decrease"
                android:src="@drawable/ic_minus"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="20dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.TriShop.Mono.Caption"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cart_qty_increase"
                android:src="@drawable/ic_plus"
                app:tint="@color/brand_primary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TriShop.Mono.PriceValue"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintTop_toTopOf="@id/qtyGroup"
            app:layout_constraintBottom_toBottomOf="@id/qtyGroup"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
