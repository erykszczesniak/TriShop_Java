<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorErrorContainer"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:text="@string/offline_banner_message"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnErrorContainer"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintTop_toBottomOf="@id/offlineBanner"
        app:layout_constraintBottom_toTopOf="@id/dockCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dock_inset"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/chat_open_button"
        android:src="@drawable/ic_sparkles"
        app:backgroundTint="@color/accent"
        app:fabCustomSize="52dp"
        app:maxImageSize="20dp"
        app:tint="@android:color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TriShop.Circle"
        app:layout_constraintBottom_toTopOf="@id/dockCard"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dockCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dock_inset"
        android:layout_marginBottom="@dimen/dock_inset"
        app:cardBackgroundColor="@color/dock_fill"
        app:cardCornerRadius="32dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_height"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/nav_item_tint"
            app:itemTextColor="@color/nav_item_tint"
            app:itemActiveIndicatorStyle="@style/Widget.TriShop.Nav.Indicator"
            app:itemTextAppearanceActive="@style/TextAppearance.TriShop.Mono.TabLabel"
            app:itemTextAppearanceInactive="@style/TextAppearance.TriShop.Mono.TabLabel"
            app:menu="@menu/bottom_nav_menu" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
