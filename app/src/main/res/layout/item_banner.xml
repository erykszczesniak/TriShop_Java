<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="@dimen/spacing_s"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="@dimen/corner_hero"
    app:cardElevation="@dimen/elevation_card">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/catalog_image_desc" />

        <TextView
            android:id="@+id/tvFeaturedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/spacing_m"
            android:background="@drawable/bg_featured_badge"
            android:paddingHorizontal="@dimen/spacing_s"
            android:paddingVertical="4dp"
            android:text="@string/home_featured_badge"
            android:textAppearance="@style/TextAppearance.TriShop.Mono.Badge"
            android:textColor="@color/brand_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_m"
            android:background="#66000000">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.TriShop.Title2"
                    android:textColor="@color/neutral_0" />

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.TriShop.Mono.Badge"
                    android:textColor="#CCFFFFFF" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:background="@drawable/bg_price_pill"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingVertical="6dp"
                android:fontFamily="@font/archivo_extrabold"
                android:textSize="14sp"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
