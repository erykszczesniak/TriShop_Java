<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <com.trishop.app.presentation.common.MeshBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_l">

                <!-- Header: brand lockup, avatar chip, category chips, filter button -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/spacing_m">

                    <TextView
                        android:id="@+id/tvBrandBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_l"
                        android:background="@drawable/bg_brand_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="@string/home_brand_badge"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvWordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="@id/tvBrandBadge"
                        app:layout_constraintBottom_toBottomOf="@id/tvBrandBadge"
                        app:layout_constraintStart_toEndOf="@id/tvBrandBadge" />

                    <TextView
                        android:id="@+id/tvKicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_l"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_kicker"
                        android:textAppearance="@style/TextAppearance.TriShop.Mono.Kicker"
                        android:textColor="?attr/colorPrimary"
                        app:layout_constraintTop_toBottomOf="@id/tvBrandBadge"
                        app:layout_constraintStart_toStartOf="parent" />

                    <FrameLayout
                        android:id="@+id/avatarChip"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/spacing_l"
                        android:background="@drawable/bg_avatar_chip"
                        android:contentDescription="@string/profile_title"
                        app:layout_constraintTop_toTopOf="@id/tvBrandBadge"
                        app:layout_constraintBottom_toBottomOf="@id/tvKicker"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:id="@+id/ivAvatarIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvAvatarInitials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </FrameLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCategoryChips"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_l"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/tvKicker"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilters"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_l"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:minHeight="@dimen/chip_height"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/filter_title"
                        android:textAppearance="@style/TextAppearance.TriShop.ButtonSmall"
                        android:textColor="?attr/colorOnSurface"
                        app:iconTint="?attr/colorOnSurface"
                        app:strokeColor="@color/glass_border"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TriShop.Pill"
                        app:icon="@drawable/ic_filter"
                        app:layout_constraintTop_toBottomOf="@id/rvCategoryChips"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvFilterBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_filter_badge"
                        android:gravity="center"
                        android:textColor="@color/neutral_0"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="@id/btnFilters"
                        app:layout_constraintTop_toTopOf="@id/btnFilters" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Featured carousel -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerBanners"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_banner_height"
                    android:layout_marginTop="@dimen/spacing_s" />

                <!-- Disciplines -->
                <TextView
                    android:id="@+id/tvDisciplinesHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_l"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/home_section_disciplines"
                    android:textAppearance="@style/TextAppearance.TriShop.Section"
                    android:textColor="?attr/colorOnSurface" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDisciplines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_m"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- New arrivals -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/arrivalsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_l"
                    android:layout_marginTop="@dimen/spacing_l">

                    <TextView
                        android:id="@+id/tvArrivalsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_section_new_arrivals"
                        android:textAppearance="@style/TextAppearance.TriShop.Section"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvProductCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TriShop.Mono.Header"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintTop_toTopOf="@id/tvArrivalsHeader"
                        app:layout_constraintBottom_toBottomOf="@id/tvArrivalsHeader"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvArrivals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="@dimen/spacing_m" />

                <!-- Recently viewed -->
                <TextView
                    android:id="@+id/tvRecentHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_l"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/home_section_recently_viewed"
                    android:textAppearance="@style/TextAppearance.TriShop.Section"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentlyViewed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
