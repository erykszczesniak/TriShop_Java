<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <com.trishop.app.presentation.common.MeshBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/detail_title"
        app:titleTextAppearance="@style/TextAppearance.TriShop.Mono.Header"
        app:titleTextColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="88dp"
            android:visibility="gone">

            <!-- Gallery in a hero glass card (iOS: radius 28, inset 20, h 400) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGallery"
                style="@style/Widget.TriShop.Card.Glass"
                android:layout_width="0dp"
                android:layout_height="@dimen/product_detail_gallery_height"
                android:layout_marginHorizontal="@dimen/screen_padding"
                app:cardCornerRadius="@dimen/corner_hero"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerGallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvGalleryCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/spacing_m"
                    android:background="@drawable/bg_featured_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.TriShop.Mono.Caption2"
                    android:textColor="@color/brand_primary" />

                <TextView
                    android:id="@+id/tvSwipeHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:text="@string/detail_swipe_hint"
                    android:textAppearance="@style/TextAppearance.TriShop.Mono.Caption2"
                    android:textColor="@color/neutral_400" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Info block: brand · category, name, price, rating, description -->
            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.TriShop.Mono.Badge"
                android:textColor="@color/brand_primary"
                app:layout_constraintTop_toBottomOf="@id/cardGallery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.TriShop.Display"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/tvBrand"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:layout_marginStart="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.TriShop.Price"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/tvName"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvOriginalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:textAppearance="@style/TextAppearance.TriShop.Mono.PriceSmall"
                android:textColor="@color/neutral_400"
                android:visibility="gone"
                app:layout_constraintBaseline_toBaselineOf="@id/tvPrice"
                app:layout_constraintStart_toEndOf="@id/tvPrice" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginStart="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.TriShop.Mono.Caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvPrice"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- iOS: description sits inside the info block, full text, no header -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.TriShop.Body"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/tvRating"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Size selector -->
            <TextView
                android:id="@+id/variantsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:text="@string/detail_variants_header"
                android:textAppearance="@style/TextAppearance.TriShop.Mono.Header"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupVariants"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:visibility="gone"
                app:singleSelection="true"
                app:layout_constraintTop_toBottomOf="@id/variantsHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Reviews (iOS: glass card, before Related) -->
            <TextView
                android:id="@+id/reviewsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.TriShop.Section"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/chipGroupVariants"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/btnWriteReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/screen_padding"
                android:text="@string/reviews_write"
                android:textAppearance="@style/TextAppearance.TriShop.Mono.Badge"
                android:textColor="@color/brand_primary"
                app:layout_constraintTop_toTopOf="@id/reviewsHeader"
                app:layout_constraintBottom_toBottomOf="@id/reviewsHeader"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReviews"
                style="@style/Widget.TriShop.Card.Glass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:layout_marginHorizontal="@dimen/screen_padding"
                app:layout_constraintTop_toBottomOf="@id/reviewsHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:id="@+id/tvReviewsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reviews_empty"
                        android:textAppearance="@style/TextAppearance.TriShop.Body"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/llReviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Related -->
            <TextView
                android:id="@+id/relatedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:text="@string/detail_related_header"
                android:textAppearance="@style/TextAppearance.TriShop.Section"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/cardReviews"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRelated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/relatedHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sticky full-width CTA (iOS bottomBar: h 58, inset 20) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToCart"
        style="@style/Widget.TriShop.Button.Pill.Tall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/spacing_m"
        android:text="@string/detail_add_to_cart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
