<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip"
    style="@style/Widget.Material3.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_s"
    android:checkable="true"
    android:textAppearance="@style/TextAppearance.TriShop.ButtonSmall"
    android:textColor="@color/chip_text_selector"
    app:checkedIconVisible="false"
    app:chipBackgroundColor="@color/chip_bg_selector"
    app:chipCornerRadius="18dp"
    app:chipMinHeight="@dimen/chip_height"
    app:chipStrokeColor="@color/glass_border"
    app:chipStrokeWidth="1dp" />
