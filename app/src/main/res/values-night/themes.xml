<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TriShop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#F97316</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="fontFamily">@font/archivo</item>
        <item name="colorOnPrimary">@color/neutral_0</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorOnPrimaryContainer">#D6E4FB</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/neutral_0</item>

        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/neutral_900</item>

        <item name="colorError">@color/error</item>

        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/neutral_100</item>
        <item name="colorSurfaceVariant">@color/surface_dark_variant</item>
        <item name="colorOnSurfaceVariant">@color/neutral_400</item>
        <item name="colorOutline">@color/neutral_700</item>

        <!-- Screen background under content — iOS AppColors.background dark. -->
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="android:windowBackground">@color/screen_background</item>

        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/screen_background</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TriShop.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TriShop.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TriShop.Large</item>
    </style>

</resources>
